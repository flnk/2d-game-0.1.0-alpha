[sub_resource type="GDScript" id="GDScript_p8kvg"]
script/source = "extends AnimatedSprite2D

# Викликається під час додавання вузла до дерева сцени.
func _ready() -> void:
	# Запускає анімацію з назвою \"Tree\"
	play(\"grass\")

# Метод _process можна видалити, якщо не плануєш додавати іншу логіку
"

