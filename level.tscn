[sub_resource type="GDScript" id="GDScript_1ainy"]
script/source = "extends Label

@onready var player = get_tree().current_scene.get_node(\"Player/Player\")

func _ready():
	print(\"NODE:\", player)
	print(\"SCRIPT:\", player.get_script())

func _process(_delta):
	text = \"HP : \" + str(player.health)
"

